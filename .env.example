# MongoDB Database
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>"
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Razorpay (UPI, Cards, Net Banking) - https://dashboard.razorpay.com/#/app/keys
# Key ID is public and used both client-side and server-side
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
# Key Secret is strictly private and must NEVER be exposed to the client
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"
# Webhook Secret from Razorpay Dashboard > Settings > Webhooks
RAZORPAY_WEBHOOK_SECRET="YOUR_RAZORPAY_WEBHOOK_SECRET"

# Stripe (International Card Payments) - https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_YOUR_STRIPE_SECRET_KEY"
STRIPE_WEBHOOK_SECRET="whsec_YOUR_STRIPE_WEBHOOK_SECRET"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate_a_strong_random_secret_here"

# Analytics & Marketing
NEXT_PUBLIC_GA_ID="G-PLACEHOLDER"

# Transactional Emails - Option A: SMTP (Gmail, Hostinger, Zoho, cPanel, etc. - Recommended)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-character-app-password"
SMTP_FROM="SpiceWizz Orders <your-email@gmail.com>"

# Transactional Emails - Option B: Resend (Requires verified custom domain to send to external recipients)
RESEND_API_KEY="re_PLACEHOLDER"
RESEND_FROM_EMAIL="SpiceWizz Orders <orders@spicewizz.com>"

